```gitignore
# ==============================
# Environment Variables & Secrets
# ==============================
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# ==============================
# Java Compiled Files
# ==============================
*.class
*.jar
*.war
*.ear

# ==============================
# Build & Output Directories
# ==============================
target/
build/
out/
bin/
dist/

# ==============================
# IDE Settings
# ==============================
.idea/
.vscode/
*.iml
.project
.classpath
.settings/
.metadata/

# ==============================
# Logs & Temporary Files
# ==============================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ==============================
# Operating System Files
# ==============================
.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# Database & Local Data
# ==============================
*.db
*.sqlite
*.sqlite3
*.mv.db
*.trace.db

# ==============================
# Dependency & Package Caches
# ==============================
.gradle/
.mvn/wrapper/maven-wrapper.jar

# ==============================
# Node.js (if used)
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Python (if used)
# ==============================
__pycache__/
*.py[cod]
.venv/
venv/

# ==============================
# Coverage & Test Reports
# ==============================
coverage/
reports/
surefire-reports/

# ==============================
# Local Configuration
# ==============================
application-local.properties
application-secret.properties
config.local.properties
```
