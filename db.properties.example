# ===================================================================
# Smart Lost & Found System - Database Configuration Template
# ===================================================================
# Copy or rename this file to 'db.properties' in the project root:
#   copy db.properties.example db.properties
#
# Then update the credentials to match your local MySQL installation.
# ===================================================================

# MySQL Hostname / IP (default: localhost)
db.host=localhost

# MySQL Port (default: 3306)
db.port=3306

# Database Name (created via database/database.sql)
db.name=smart_lost_found

# MySQL Username (default: root)
db.user=root

# MySQL Password (replace with your local MySQL root password)
db.password=YOUR_MYSQL_PASSWORD
